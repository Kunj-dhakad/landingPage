generator client {
 provider = "prisma-client-js"
 output = "../node_modules/@navonixx/prisma-client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
model AdminUser {
 id String @id @default(uuid())
 email String @unique
 passwordHash String
 role String @default("ADMIN")
 enabled Boolean @default(true)
 createdAt DateTime @default(now())
 sessions AdminSession[]
}
model AdminSession {
 id String @id @default(uuid())
 tokenHash String @unique
 adminId String
 admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
}
model Lead {
 id String @id @default(uuid())
 email String @unique
 name String?
 status String @default("TRANSACTIONAL")
 source String?
 campaign String?
 verifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 consents EmailConsent[]
 tokens EmailVerification[]
 deliveries EmailDelivery[]
 downloads ResourceDownload[]
 @@index([createdAt])
 @@index([status])
}
model EmailConsent {
 id String @id @default(uuid())
 leadId String
 lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
 granted Boolean
 purpose String @default("marketing")
 noticeVersion String @default("2026-10-v1")
 createdAt DateTime @default(now())
}
model EmailVerification {
 id String @id @default(uuid())
 leadId String
 lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
 tokenHash String @unique
 purpose String
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 @@index([expiresAt])
}
model EmailDelivery {
 id String @id @default(uuid())
 leadId String
 lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
 resourceSlug String?
 kind String
 status String @default("PENDING")
 providerId String?
 error String?
 createdAt DateTime @default(now())
 @@index([createdAt, status])
}
model Resource {
 id String @id @default(uuid())
 slug String @unique
 kind String
 title String
 description String
 body String
 category String
 assetPath String?
 coverUrl String?
 published Boolean @default(false)
 featured Boolean @default(false)
 emailCapture Boolean @default(false)
 seoTitle String?
 seoDescription String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 downloads ResourceDownload[]
 @@index([kind, published])
}
model ResourceDownload {
 id String @id @default(uuid())
 resourceId String
 resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
 leadId String?
 lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model FreeTool {
 id String @id @default(uuid())
 slug String @unique
 title String
 description String
 category String
 enabled Boolean @default(true)
 featured Boolean @default(false)
 seoTitle String?
 seoDescription String?
 iconUrl String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model AffiliateTool {
 id String @id @default(uuid())
 slug String @unique
 name String
 description String
 body String
 category String
 pricingModel String @default("UNVERIFIED")
 pricingDescription String @default("Confirm current pricing on the official website.")
 freePlan String @default("Unverified")
 features String[]
 advantages String[]
 limitations String[]
 platforms String[]
 useCases String[]
 officialUrl String
 destinationUrl String?
 logoUrl String?
 affiliate Boolean @default(false)
 published Boolean @default(false)
 featured Boolean @default(false)
 lastVerifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 clicks AffiliateClick[]
 @@index([published, category])
}
model AffiliateClick {
 id String @id @default(uuid())
 toolId String
 tool AffiliateTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
 source String?
 campaign String?
 createdAt DateTime @default(now())
 @@index([createdAt, toolId])
}
model Visitor {
 id String @id @default(uuid())
 consentVersion String
 createdAt DateTime @default(now())
 sessions VisitSession[]
}
model VisitSession {
 id String @id @default(uuid())
 visitorId String
 visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
 landingPage String
 exitPage String?
 source String?
 medium String?
 campaign String?
 content String?
 term String?
 referrerDomain String?
 device String?
 browser String?
 os String?
 country String?
 region String?
 startedAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 events AnalyticsEvent[]
 @@index([startedAt])
 @@index([source, campaign])
}
model AnalyticsEvent {
 id String @id
 name String
 path String
 slug String?
 category String?
 sessionId String?
 session VisitSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
 createdAt DateTime @default(now())
 @@index([createdAt, name])
 @@index([slug, name, createdAt])
 @@index([path, createdAt])
}
model Campaign {
 id String @id @default(uuid())
 name String
 source String
 medium String
 url String
 createdAt DateTime @default(now())
}
model ContactSubmission {
 id String @id @default(uuid())
 name String
 email String
 message String
 status String @default("NEW")
 createdAt DateTime @default(now())
}
model SiteSetting {
 key String @id
 value String
 updatedAt DateTime @updatedAt
}
model AdminAuditLog {
 id String @id @default(uuid())
 adminId String
 action String
 entity String
 entityId String?
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}
