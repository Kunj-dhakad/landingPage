# Dummy template only. Copy to .env and fill in your own values.
# .env contains local secrets and must never be committed.

# Replace the dummy database credentials and database name.
DATABASE_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/YOUR_DATABASE_NAME?schema=public"
DIRECT_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/YOUR_DATABASE_NAME?schema=public"

# Local development URLs; use the final HTTPS origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Required: generate a unique, strong authentication secret in .env.
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.test"
# Required: set a unique, strong admin password in .env before seeding.
ADMIN_PASSWORD=""

# Optional services: fill these only in .env or the hosting secret settings.
RESEND_API_KEY=""
EMAIL_FROM=""
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_HOST=""
CRON_SECRET=""

# ImageKit: server-side uploads. Fill in the private key from Developer options > API keys.
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/0y2jm8mid"
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_UPLOAD_FOLDER="/navonixx"
